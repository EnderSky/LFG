{
    "name": "lfg",
    "version": "1.0.0",
    "description": "A Telegram bot designed to help hostel guests find friends for gaming and manage shared resources across multiple locations.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:debug": "LOG_LEVEL=DEBUG tsx watch src/index.ts",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "start": "node dist/index.js",
        "start:prod": "NODE_ENV=production LOG_LEVEL=INFO node dist/index.js",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch",
        "lint": "echo 'No linter configured yet'",
        "test": "echo 'No tests configured yet'",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean",
        "prestart": "npm run build"
    },
    "keywords": [
        "telegram",
        "bot",
        "gaming",
        "hostel",
        "social"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@supabase/supabase-js": "^2.99.2",
        "dotenv": "^17.3.1",
        "grammy": "^1.41.1"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
